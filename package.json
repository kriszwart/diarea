{
  "name": "diarea",
  "version": "0.3.2",
  "description": "Finds what your frontend leaks before anyone else does: exposed keys, source maps, API maps, AI system prompts and debug globals, scored from Sealed to Gushing. Local and read-only.",
  "author": "Kris Zwart (ZwartifyDesign)",
  "homepage": "https://diarea.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriszwart/diarea.git"
  },
  "bugs": {
    "url": "https://github.com/kriszwart/diarea/issues"
  },
  "type": "module",
  "bin": {
    "diarea": "bin/diarea.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:extension": "node scripts/build.js extension",
    "build:site": "node scripts/build.js site",
    "scan": "node bin/diarea.js scan",
    "test": "node test/run.js",
    "package:extension": "node scripts/package-extension.js",
    "store:assets": "node scripts/render-store-assets.js"
  },
  "keywords": [
    "security",
    "frontend",
    "leak-scanner",
    "source-maps",
    "secrets",
    "reverse-engineering",
    "ai",
    "llm",
    "cli",
    "github-action",
    "chrome-extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "jsdom": "^24"
  },
  "optionalDependencies": {
    "playwright": "^1.47"
  }
}
