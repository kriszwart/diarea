{
  "manifest_version": 3,
  "name": "Diarea",
  "version": "0.6.0",
  "description": "Finds what your frontend leaks: keys, source maps, API maps and AI prompts, scored Sealed to Gushing. Local only.",
  "homepage_url": "https://diarea.tools/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Diarea: scan this page for leaks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
